CompileFlags:
  # Always consume the active MSVC-flavoured database copied to the repo root.
  # The activation task replaces this compatibility copy with the selected
  # variant's database while PCH/headers remain in build/clangd/<Variant>.
  CompilationDatabase: .

  # CMake emits MSVC PCH/output flags that are useful to cl.exe but make clangd
  # depend on stale or compiler-specific build artifacts. Keep /FI so clangd
  # still parses the PCH header as source after dropping the binary PCH flags.
  Remove:
    - -std=*
    - -std:*
    - /std:*
    - /Yc*
    - /Yu*
    - /Fp*
    - /Fd*
    - /Fo*
    - /FS
    - /GL
  Add:
    - /std:c++latest
    # The Visual Studio generator sets CharacterSet=Unicode for Core/CoreCS.
    # Ninja compile databases do not carry that MSBuild property.
    - /DUNICODE
    - /D_UNICODE

Diagnostics:
  # The user-level clangd profile enables -Wall globally. These warnings are
  # compatibility/lifetime audits rather than source errors for this project.
  Suppress:
    - -Wc++98-compat
    - -Wc++98-compat-pedantic
    - -Wexit-time-destructors
    - -Wglobal-constructors
  ClangTidy:
    Remove:
      - "*"

---

# Vendored SDK code, generated files, and HLSL compatibility headers are not
# standalone project translation units. Let project sources include them, but
# do not publish diagnostics from (or background-index) those files directly.
# The FidelityFX HLSL headers are also mapped to `plaintext` in the workspace
# settings: parser-fatal HLSL/C++ errors cannot be hidden by Diagnostics.Suppress.
If:
  # clangd 22 reports Windows paths with both slash styles depending on the
  # caller (LSP URI vs. compile-database path). Avoid separator-sensitive regex.
  PathMatch: '.*(extern|build).*'
CompileFlags:
  # Suppressed vendor diagnostics can still hit Clang's default error limit,
  # which publishes a lone fatal_too_many_errors diagnostic. Disable that
  # summary for non-project translation units while keeping their diagnostics
  # suppressed below.
  Add: [ -ferror-limit=0 ]
Diagnostics:
  Suppress: '*'
Index:
  Background: Skip
